# Production host is Telecloud ECS at https://mls.et (GitHub Action
# "Deploy to Telecloud" on main). This file is a template — never put live
# secrets here. The repository is public.
#
# Required on the Telecloud host before the next deploy that includes
# session hardening. A long random string (32+ bytes). Sign-in refuses to
# issue cookies when this is missing in production. Do not reuse GEMINI_API_KEY.
# AUTH_SESSION_SECRET=
#
# Supabase Postgres (pooler)
# DATABASE_URL — transaction pooler :6543 (?pgbouncer=true) for the app
# DIRECT_URL  — session pooler :5432 for migrations
# DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"
#
# Local PostGIS via docker compose (fallback):
# DATABASE_URL="postgresql://ethiomls:ethiomls@localhost:5432/ethiomls?schema=public"
# DIRECT_URL="postgresql://ethiomls:ethiomls@localhost:5432/ethiomls?schema=public"
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Redis (BullMQ broadcast queue — see docker-compose.yml)
REDIS_URL="redis://127.0.0.1:6379"

# Public site URL used in SMS + Telegram deep links (official: mls.et on Telecloud ECS)
NEXT_PUBLIC_SITE_URL="https://mls.et"

# Google Maps JS API (decorative backgrounds + listing maps). Set on the Telecloud host.
# Restrict the key to your domain(s) and enable Maps JavaScript API.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Gemini via @google/genai — required for document parse + search assist
# Set the same key in the Telecloud host environment (production).
# Prefer an AI Studio key (AIza… or current auth keys). AQ.* keys can work after billing.
# GEMINI_API_KEY=
# Prefer current Flash IDs — AQ.* keys often reject older 2.5 flash.
# GEMINI_MODEL=gemini-3.5-flash
# Fallbacks in code: gemini-flash-latest, gemini-3-flash-preview, gemini-3.1-flash-lite
# Optional Vertex (needs Agent Platform API enabled on the GCP project):
# GEMINI_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
# Optional AI Gateway base URL (Netlify auto-injects when AI is enabled):
# GOOGLE_GEMINI_BASE_URL=

# Optional National ID (Fayda / VeriFayda eSignet) — leave unset for demo mock verify
# Apply at https://id.gov.et/api then set:
# FAYDA_CLIENT_ID=
# FAYDA_AUTHORIZE_URL=
# FAYDA_TOKEN_URL=
# FAYDA_USERINFO_URL=
# FAYDA_PRIVATE_KEY_BASE64=
# FAYDA_REDIRECT_URI=https://mls.et/api/auth/fayda/callback

# Optional Supabase Storage for listing evidence (falls back to DB bytes)
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Google / Gmail OAuth (leave unset until credentials exist)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Local: http://localhost:3000/api/auth/google/callback
# Production (Telecloud): https://mls.et/api/auth/google/callback
# GOOGLE_REDIRECT_URI=

# Optional Google Workspace status on admin workspace (Admin SDK + Licensing)
# GOOGLE_WORKSPACE_CUSTOMER_ID=C01234567
# GOOGLE_WORKSPACE_ADMIN_EMAIL=admin@yourdomain.com
# Single-line JSON for a service account with domain-wide delegation:
# GOOGLE_WORKSPACE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}

# Optional GitHub subscription/plan status on admin workspace
# GITHUB_TOKEN=ghp_...
# GITHUB_ORG=your-org  # optional; when set, shows org plan/seats instead of user plan

# Optional National Bank of Ethiopia USD/ETB day-rate override (proxy used if unset)
# Optional manual override — normally unnecessary: the app pulls the official
# NBE USD/ETB indicative rate live from api.nbe.gov.et (1-hour cache).
# NBE_USD_ETB_RATE=

# Telebirr / CBE Birr webhook signature secrets.
# Required in production — the app rejects the old public dev strings
# (telebirr-dev-secret / cbe-birr-dev-secret) and mock signatures when
# NODE_ENV=production. Generate unique values; do not commit them.
# TELEBIRR_WEBHOOK_SECRET=
# CBE_BIRR_WEBHOOK_SECRET=

# SMS transport: mock | gateway (shared Python AfroMessage push on host)
SMS_PROVIDER="gateway"
SMS_FROM="EthioMLS"
# SMS_PUSH_URL=http://127.0.0.1:8091
# SMS_PUSH_APP_KEY=   # must match SMS_PUSH_APP_KEY_ETHIOMLS on the push host
# Scrape invite: when true (or ?mode=auto), SMS fires on ingest; default is manual review.
# SCRAPE_AUTO_SEND=false

# AGT CRM (ECS: https://agtplc.et)
# The live Telecloud host sets these three. Scraped listings POST to
#   POST https://agtplc.et/api/crm/register-ethiomls-listing
# with CRM_APP_API_KEY (header auth). Agents review at
# https://agtplc.et/agent/leads/review and /admin/scrape-review.
# Do not set SCRAPE_DESTINATION=local unless you intentionally want EthioMLS
# PENDING_REVIEW upserts instead of CRM Review.
# With SCRAPE_DESTINATION=crm the scrape still POSTs to AGT CRM, then mirrors
# the same row into this database as PENDING_REVIEW + tag agt-crm-activation
# so https://mls.et/listings can show it. CRM Review is unchanged.
AGT_CRM_BASE_URL=https://agtplc.et
CRM_APP_API_KEY=
SCRAPE_DESTINATION=crm
# AGT_CRM_API_KEY=   # alias for CRM_APP_API_KEY if the primary name is unset
# On production boot (NODE_ENV=production and SCRAPE_DESTINATION=crm) the
# server pulls CRM scrapes into this database once per process. Set
# CRM_CATALOG_SYNC_ON_BOOT=false to disable that pull.
# CRM_CATALOG_SYNC_ON_BOOT=
# Manual pull on the Telecloud host (needs DATABASE_URL and an active user):
#   npm run scrape:seed-from-crm -- --local
# AGT_CRM_SCRAPES_PATH=/api/admin/scrape-properties
# ETHIOMLS_BASE_URL=https://mls.et
# CRM_INGEST_API_KEY=  # optional override; CRM_APP_API_KEY is accepted for ingest

# Cloudflare Turnstile (signup + password-reset OTP). Create keys at
# https://dash.cloudflare.com/?to=/:account/turnstile
# When unset, captcha is skipped (local/mock). When set, register/reset require it.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional legacy Vercel Firewall autoblock. Production hosting is Telecloud,
# so leave these unset. If you ever enable the optional path, use placeholders
# — do not commit a real token or project id.
# VERCEL_FIREWALL_AUTOBLOCK=
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=

# Telegram Bot API (omit token to mock-publish to console)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_DISPLAY_CURRENCY=ETB
TELEGRAM_CHANNEL="@EthioMLS_Official"

# Optional SMS vendor keys. Production uses the shared AfroMessage push gateway
# (SMS_PROVIDER=gateway + SMS_PUSH_URL + SMS_PUSH_APP_KEY). The names below are
# read by the admin integration-status panel when a direct vendor is configured.
# AFROMESSAGE_API_KEY=
# HAHU_API_KEY=
# HAHU_API_SECRET=
# HAHU_DEVICE_ID=
# SMSETHIOPIA_API_KEY=

# Scrape cron (scripts / src/cron). Optional.
# SCRAPE_ADMIN_USER_ID=
# SCRAPE_TARGETS=
# SCRAPE_DRY_RUN=false
# SCRAPE_DEVELOPERS_DELAY_MS=750
# SCRAPE_CRON_SCHEDULE=
# SCRAPE_TIMEZONE=Africa/Addis_Ababa

# Alternate public origin alias (getSiteUrl falls back to https://mls.et).
# NEXT_PUBLIC_APP_URL=https://mls.et
# Optional manual NBE display rate. Live rate comes from api.nbe.gov.et.
# NEXT_PUBLIC_NBE_USD_ETB_RATE=

# Gemini transport overrides (normally leave unset on Telecloud).
# GEMINI_FORCE_GOOGLE_API=
# GOOGLE_GENAI_USE_VERTEXAI=
# VERTEX_LOCATION=us-central1
# NETLIFY_AI_GATEWAY_BASE_URL=
# NETLIFY_AI_GATEWAY_KEY=
